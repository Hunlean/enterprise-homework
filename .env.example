# Copy this file to ".env" and fill in your values.

# Port for the website
PORT=3000

# Public address of the website (used for links the bot sends).
# To turn on the Telegram Mini App this MUST be an https address,
# e.g. your ngrok URL: SITE_URL=https://abcd-1234.ngrok-free.app
SITE_URL=http://localhost:3000

# Shop name shown on the website and in the bot
SHOP_NAME=XCYZ Phone Shop

# Token from @BotFather on Telegram (leave empty to run the website without the bot)
TELEGRAM_BOT_TOKEN=

# Password for the admin page (/admin.html)
ADMIN_PASSWORD=admin123
